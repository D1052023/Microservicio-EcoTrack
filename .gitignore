.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
secrets/
credentials.json
credentials*.json
serviceAccount*.json
*.secret
*.token

# ─── Next.js / build ────────────────────────────────────────
/.next/
/out/
/build
/dist
.vercel
.turbo

# ─── Testing y cobertura ──────────────────────────────────
/coverage
*.lcov

# ─── Logs y caché ───────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.cache
.eslintcache

# ─── TypeScript ─────────────────────────────────────────────
